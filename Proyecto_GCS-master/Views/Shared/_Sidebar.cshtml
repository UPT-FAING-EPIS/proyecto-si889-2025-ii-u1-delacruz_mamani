@{
    var controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var action = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    Func<string, string, bool> isActive = (c, a) =>
    {
        var cOk = controller.Equals(c, System.StringComparison.OrdinalIgnoreCase);
        var aOk = string.IsNullOrEmpty(a) || action.Equals(a, System.StringComparison.OrdinalIgnoreCase);
        return cOk && aOk;
    };
}

