@model Proyecto_GCS.Models.Proyecto
@{ ViewBag.Title = "Editar Proyecto"; }
<h1 class="text-2xl font-bold mb-6">Editar proyecto</h1>

@using (Html.BeginForm("Editar", "Proyectos", FormMethod.Post, new { @class = "space-y-4" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdProyecto)
    @Html.Partial("_FormProyecto", Model)
    <div class="pt-2 flex gap-2">
        <a href="@Url.Action("Detalle", new { id = Model.IdProyecto })" class="px-4 py-2 rounded-xl border border-slate-300">Volver</a>
        <button class="px-4 py-2 rounded-xl bg-emerald-500 text-white hover:bg-emerald-600">Guardar</button>
    </div>
}
